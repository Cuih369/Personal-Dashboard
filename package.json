{
  "name": "personal-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "行为型生产力助手 — 不是帮你列更多任务，而是陪你把事情做完。全本地存储，无需账号。",
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:app": "uni -p app",
    "build:app": "uni build -p app",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030120260930001",
    "echarts-for-uniapp": "^1.1.0",
    "pinia": "2.2.4",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030120260930001",
    "@types/node": "^22.7.5",
    "sass": "^1.80.0",
    "typescript": "^5.4.5",
    "vite": "5.2.8",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.6"
  },
  "engines": {
    "node": ">=18"
  }
}
